node_modules/

# Web build artifacts (vite output)
src/interfaces/web/dist/

# Playwright run output
src/interfaces/web/test-results/
src/interfaces/web/e2e/reports/
src/interfaces/web/playwright-report/

# APC context skill — canonical source is agentprojectcontext/apc (synced at install/prepack)
skills/apc-context/

# Runtime data — never commit real session logs or runtime state
**/.apc/messages/*.jsonl
**/.apc/messages/*.md
**/.apc/agents/*/sessions/*.md
**/.apc/agents/*/conversations/*.md

# Global APX home (user config, tokens, state)
.apx/

# Env / secrets
.env
.env.*
!.env.example
secrets/

# macOS
.DS_Store
testing
opencode_ref/

# Claude Code worktrees / local state
.claude/

/tmp

# QA artifacts — local only (raw logs may contain config dumps with secrets)
qa/
# Build artifacts (root) — compiled CLI/TUI, not shipped to npm
/dist/

# Internal planning docs — local only (roadmap, PRDs, backlog, feature dossiers,
# the running code-vs-contract survey). Layout: spec/active/ + spec/archive/.
#
# Planning is not a guardrail. Everything an outside reader needs — the deep
# dives, the workflow playbooks and the ADRs — lives in top-level rules/ and is
# TRACKED. The ADRs were in here for months while five tracked files linked to
# them, which made those links dead in every fresh clone; they now live in
# rules/decisions/. Never link to this directory from a tracked file.
/spec/

# Screenshot harness — local dev tool, not shipped
src/interfaces/web/scripts/shots.mjs

.playwright-mcp/