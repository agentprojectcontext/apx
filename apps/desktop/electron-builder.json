{
  "appId": "dev.apx.desktop",
  "productName": "APX",
  "extraMetadata": { "name": "apx" },
  "artifactName": "APX-${version}-${os}-${arch}.${ext}",
  "directories": {
    "output": "../../out",
    "buildResources": "assets"
  },
  "files": ["dist/**", "package.json", "!node_modules/**"],
  "extraResources": [
    {
      "from": ".stage/apx",
      "to": "apx",
      "filter": ["**/*"]
    },
    {
      "from": ".stage/apx/node_modules",
      "to": "apx/node_modules",
      "filter": ["**/*"]
    }
  ],
  "npmRebuild": false,
  "electronVersion": "44.5.1",
  "publish": null,
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "assets/icon.png",
    "category": "public.app-category.productivity",
    "identity": "-",
    "hardenedRuntime": false
  },
  "win": {
    "target": ["nsis", "zip"],
    "icon": "assets/icon.png"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "runAfterFinish": true
  },
  "linux": {
    "target": ["AppImage", "zip"],
    "icon": "assets/icon.png",
    "category": "Utility",
    "maintainer": "APX",
    "synopsis": "Your agents, your projects, one local core.",
    "executableName": "apx"
  }
}
