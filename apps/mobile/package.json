{
  "name": "@apx/mobile",
  "version": "2.0.3",
  "private": true,
  "description": "APX on the phone (Expo, iOS + Android): paired with a QR, talks to the owner's core with a key of its own.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "sync:design": "node scripts/sync-design-assets.mjs",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "node --test \"src/**/*.test.ts\"",
    "test:ui": "jest --runInBand"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.26",
    "expo-audio": "~57.0.5",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.20",
    "expo-location": "~57.0.20",
    "expo-media-library": "~57.0.5",
    "expo-notifications": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~5.9.0"
  }
}
