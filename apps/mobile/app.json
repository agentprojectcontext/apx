{
  "expo": {
    "name": "APX",
    "slug": "apx",
    "scheme": "apx",
    "version": "2.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "../desktop/assets/icon.png",
    "ios": {
      "bundleIdentifier": "dev.apx.mobile",
      "supportsTablet": true,
      "buildNumber": "2"
    },
    "android": {
      "package": "dev.apx.mobile",
      "versionCode": 2
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "APX uses the camera to scan the QR that pairs it with your computer, and to take a picture when an agent asks you for one."
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "APX tells your agents where you are when they ask (only while the app is open)."
        }
      ],
      "expo-notifications",
      "./plugins/with-ios-scenes.js"
    ]
  }
}
