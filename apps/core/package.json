{
  "name": "@apx/core",
  "version": "0.0.0",
  "private": true,
  "description": "The head of APX: the daemon. Owns state, agents, threads, channels, scheduler and the protocol server.",
  "type": "module",
  "bin": {
    "apx-core": "./src/main.ts"
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc -p .",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.286",
    "@apx/protocol": "workspace:*",
    "@openai/codex-sdk": "0.159.3",
    "kysely": "0.29.6",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@apx/config": "workspace:*",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@types/ws": "^8.18.1"
  }
}
