---
import { getCollection } from "astro:content";
import BlogPage from "../../../components/blog/BlogPage.astro";
import { publishedPosts } from "../../../data/blog.mjs";
export async function getStaticPaths() {
  return publishedPosts(await getCollection("blog"))
    .filter(({ data }) => data.lang === "es")
    .map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}
const { post } = Astro.props;
---
<BlogPage lang="es" post={post} />
