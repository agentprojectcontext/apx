---
import { getCollection } from "astro:content";
import { publishedPosts } from "../../data/blog.mjs";
import BlogPage from "../../components/blog/BlogPage.astro";
export async function getStaticPaths() {
  return publishedPosts(await getCollection("blog")).filter(({ data }) => data.lang === "en").map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}
const { post } = Astro.props;
---
<BlogPage lang="en" post={post} />
