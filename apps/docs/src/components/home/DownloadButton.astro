---
// The hero's download: one button for the reader's system and a menu with the others. Files carry the version in
// their name, so the links are filled from the latest release when the page loads; until then they open its page.
import type { HomeText } from "../../i18n/home";
import OsIcon from "../OsIcon.astro";

interface Props {
  t: HomeText["get"];
  releases: string;
}
const { t, releases } = Astro.props;
const desktop = [
  { id: "mac-arm64", icon: "mac", name: t.macArm, short: "macOS", file: "-mac-arm64.dmg" },
  { id: "mac-x64", icon: "mac", name: t.macIntel, short: "macOS", file: "-mac-x64.dmg" },
  { id: "win", icon: "windows", name: "Windows", short: "Windows", file: "-win-x64.exe" },
  { id: "linux", icon: "linux", name: "Linux", short: "Linux", file: "-linux-x86_64.AppImage" },
  { id: "linux-arm64", icon: "linux", name: t.linuxArm, short: "Linux", file: "-linux-arm64.AppImage" },
] as const;
const phone = [{ id: "android", icon: "android", name: "Android", short: "Android", file: "-android.apk" }] as const;
---

<div class="getapx" id="getApx" data-for={t.for} data-app={t.app}>
  <a class="btn btn-accent getapx__main" href={releases} data-pick="mac-arm64">
    <OsIcon name="mac" /><span class="getapx__label">{t.for} macOS</span>
  </a>
  <button class="btn btn-accent getapx__more" type="button" aria-haspopup="menu" aria-expanded="false" aria-label={t.more}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
  </button>
  <div class="getapx__menu" role="menu" hidden>
    {
      desktop.map((o) => (
        <a role="menuitem" href={releases} data-id={o.id} data-file={o.file} data-short={o.short}>
          <OsIcon name={o.icon} />
          <span>{o.name}</span>
        </a>
      ))
    }
    <p class="getapx__group">{t.phone}</p>
    {
      phone.map((o) => (
        <a role="menuitem" href={releases} data-id={o.id} data-file={o.file} data-short={o.short}>
          <OsIcon name={o.icon} />
          <span>{o.name}</span>
        </a>
      ))
    }
    <a role="menuitem" class="getapx__all" href={releases}>{t.all} ↗</a>
  </div>
</div>

<style is:global>
  .getapx {
    position: relative;
    display: inline-flex;
  }
  .getapx .getapx__main {
    border-radius: 999px 0 0 999px;
    padding-right: 20px;
  }
  .getapx .getapx__more {
    border-radius: 0 999px 999px 0;
    padding: 0 16px 0 14px;
    border-left: 1px solid rgba(4, 34, 12, 0.22);
  }
  .getapx__more svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s;
  }
  .getapx__more[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }
  .getapx__menu {
    position: absolute;
    z-index: 20;
    top: calc(100% + 8px);
    left: 0;
    min-width: 100%;
    width: max-content;
    padding: 6px;
    border-radius: 16px;
    background: var(--card);
    border: 1px solid var(--line-2);
    box-shadow: 0 18px 50px var(--shadow);
    text-align: left;
  }
  .getapx__menu[hidden] {
    display: none;
  }
  .getapx__menu a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 10px;
    color: var(--fg);
    font: 500 14px / 1.2 var(--sans);
    text-decoration: none;
  }
  .getapx__menu a:hover,
  .getapx__menu a:focus-visible {
    background: var(--ghost);
    outline: none;
  }
  .getapx__menu a[aria-current="true"] {
    background: var(--ghost-2);
  }
  .getapx__group {
    margin: 6px 0 0;
    padding: 10px 12px 4px;
    border-top: 1px solid var(--line);
    font: 500 11px / 1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .getapx__menu .getapx__all {
    margin-top: 6px;
    border-top: 1px solid var(--line);
    border-radius: 0 0 10px 10px;
    color: var(--muted);
    font-size: 13px;
  }
</style>

<script>
  type Ua = Navigator & { userAgentData?: { platform?: string } };
  const root = document.getElementById("getApx");
  if (root) {
    const main = root.querySelector<HTMLAnchorElement>(".getapx__main")!;
    const more = root.querySelector<HTMLButtonElement>(".getapx__more")!;
    const menu = root.querySelector<HTMLElement>(".getapx__menu")!;
    const items = [...menu.querySelectorAll<HTMLAnchorElement>("a[data-id]")];

    // The reader's system picks the main button; an iPhone or an unknown one keeps the full list of downloads.
    const ua = navigator.userAgent;
    const platform = (navigator as Ua).userAgentData?.platform ?? navigator.platform;
    const pick = /android/i.test(ua)
      ? "android"
      : /iphone|ipad|ipod/i.test(ua)
        ? ""
        : /win/i.test(platform)
          ? "win"
          : /linux/i.test(platform)
            ? /arm|aarch/i.test(platform) ? "linux-arm64" : "linux"
            : /mac/i.test(platform)
              ? "mac-arm64"
              : "";
    const choose = (id: string) => {
      const item = items.find((i) => i.dataset.id === id);
      if (!item) {
        main.dataset.pick = "";
        main.href = "#download";
        main.querySelector("svg")?.remove();
        main.querySelector(".getapx__label")!.textContent = root.dataset.app ?? "";
        return;
      }
      main.dataset.pick = id;
      main.href = item.href;
      main.querySelector("svg")?.replaceWith(item.querySelector("svg")!.cloneNode(true));
      main.querySelector(".getapx__label")!.textContent = `${root.dataset.for} ${item.dataset.short}`;
      for (const i of items) i.setAttribute("aria-current", String(i === item));
    };
    choose(pick);

    const open = (on: boolean) => {
      menu.hidden = !on;
      more.setAttribute("aria-expanded", String(on));
      if (on) (menu.querySelector("[aria-current=true]") as HTMLElement | null)?.focus();
    };
    more.addEventListener("click", () => open(menu.hidden));
    document.addEventListener("click", (e) => {
      if (!root.contains(e.target as Node)) open(false);
    });
    root.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !menu.hidden) {
        open(false);
        more.focus();
      }
      if ((e.key === "ArrowDown" || e.key === "ArrowUp") && !menu.hidden) {
        e.preventDefault();
        const all = [...menu.querySelectorAll<HTMLAnchorElement>("a")];
        const at = all.indexOf(document.activeElement as HTMLAnchorElement);
        all[(at + (e.key === "ArrowDown" ? 1 : all.length - 1)) % all.length]?.focus();
      }
    });

    // Direct links from the latest release; without them every entry still opens the releases page.
    fetch("https://api.github.com/repos/agentprojectcontext/apx/releases/latest")
      .then((r) => (r.ok ? r.json() : null))
      .then((release: { assets?: { name: string; browser_download_url: string }[] } | null) => {
        for (const item of items) {
          const asset = release?.assets?.find((a) => a.name.endsWith(item.dataset.file ?? "\0"));
          if (asset) item.href = asset.browser_download_url;
        }
        choose(main.dataset.pick ?? "");
      })
      .catch(() => {});
  }
</script>
