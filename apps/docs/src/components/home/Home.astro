---
import { sitePath } from "../../doc-routes.mjs";
import { HOME, type Lang } from "../../i18n/home";
import AnalyticsConsent from "../AnalyticsConsent.astro";
import Blob from "../Blob.astro";
import BlobEyes from "../BlobEyes.astro";
import OsIcon from "../OsIcon.astro";
import Shot from "../Shot.astro";
import Terminal from "../Terminal.astro";
import WebFooter from "../web/WebFooter.astro";
import WebHeader from "../web/WebHeader.astro";
import DownloadButton from "./DownloadButton.astro";
import DownloadCards from "./DownloadCards.astro";
// The docs' front page, in the site's look: a hero with a blobo, the real panel, the way in, and the crew.
import HomeDiscovery from "./HomeDiscovery.astro";
import "./home.css";
import "./hero-term.css";
import "./hero-os.css";
import "./news.css";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = HOME[lang];
const href = (path: string) => sitePath(path, import.meta.env.BASE_URL);
const pre = lang === "es" ? "/es" : "";
// v2's releases are not GitHub's "Latest" while v1 shares the repo, so the scripts are served by this site.
const site = "https://apxagent.app";
const install = `curl -fsSL ${site}/install.sh | bash`;
const installWin = `irm ${site}/install.ps1 | iex`;
const installServer = `curl -fsSL ${site}/install.sh | bash -s -- --server`;
const releases = "https://github.com/agentprojectcontext/apx/releases?q=v2&expanded=true";
const heroBlobs = ["menta", "orbita", "cobalto", "brasa", "amatista"] as const;
const parade = [
  "menta",
  "brasa",
  "trino",
  "amatista",
  "cobalto",
  "volcan",
  "noche",
  "kiwi",
  "gajo",
  "zafiro",
  "rubi",
  "trebol",
  "onyx",
  "perla",
  "faro",
  "aqua",
  "orbita",
] as const;
const discord = "https://discord.gg/vxdZuT5WuE";
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href={href("/")} />
    <link rel="alternate" hreflang="es" href={href("/es/")} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(href(lang === "es" ? "/es/" : "/"), Astro.site).href} />
    <meta property="og:image" content={new URL(href("/og.jpg"), Astro.site).href} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="APX: meet your crew. AI agents that live on your computer." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(href("/og.jpg"), Astro.site).href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300..800&family=Geist+Mono:wght@400;500;600&display=swap"
    />
    <script is:inline>
      // Same choice as the doc pages (Starlight's key): stored, else the system's.
      (() => {
        let t = "";
        try {
          t = localStorage.getItem("starlight-theme") || "";
        } catch {}
        if (t !== "light" && t !== "dark") t = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body class="h">
    <div class="grain" aria-hidden="true"></div>

    <WebHeader lang={lang} />

    <header class="hero">
      <div class="wrap">
        <a class="pill pill--os" href="#download">
          <b class="pill__new">{t.pill.strong}</b><span class="pill__on">{t.pill.rest}</span>
          {
            (["mac", "windows", "linux", "android"] as const).map((os) => (
              <span class="pill__os">
                <OsIcon name={os} size={14} />
                <span>{{ mac: "macOS", windows: "Windows", linux: "Linux", android: "Android" }[os]}</span>
              </span>
            ))
          }
        </a>
        <h1 class="hero__title">
          <span class="row">
            <span class="split">{t.meet}</span>
            <span class="hero__blob" id="heroBlob">
              {heroBlobs.map((b, i) => <Blob name={b} size="100%" class={i === 0 ? "on" : ""} />)}
            </span>
            <span class="split">{t.your}</span>
          </span>
          <span class="row"><span class="word" id="word" data-words={JSON.stringify(t.words)}>{t.words[0]}</span></span>
        </h1>
        <p class="hero__sub"><b>{t.sub.strong}</b> {t.sub.rest}</p>
        <div class="hero__actions">
          <DownloadButton t={t.get} releases={releases} />
          <button class="btn btn-ghost hero__term" type="button" aria-expanded="false" aria-controls="heroInstall">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6l6 6-6 6M12 19h8" /></svg>{t.get.terminal}
          </button>
        </div>
        <div class="hero__actions hero__install" id="heroInstall" hidden data-unix={install} data-win={installWin}>
          <button class="install" type="button" data-copy={install} data-done={t.copied}>
            <span class="dollar">$</span><span class="cmd">{install}</span><span class="copy">{t.copy}</span>
          </button>
          <div class="os" role="group" aria-label={t.os.label}>
            <button type="button" data-os="unix" aria-pressed="true" title={t.os.unix}>
              <OsIcon name="mac" /><OsIcon name="linux" />
            </button>
            <button type="button" data-os="win" aria-pressed="false" title={t.os.win}>
              <OsIcon name="windows" />
            </button>
            <span class="os__for" data-unix={t.os.unix} data-win={t.os.win}>{t.os.unix}</span>
          </div>
          <p class="hero__where">
            {t.os.where} <a href={href(`${pre}/devices/server/`)}>{t.os.whereLink} →</a>
          </p>
        </div>
        <div class="status" id="status" data-lines={JSON.stringify(t.status)}>
          <Blob name="menta" size={26} />
          <b id="statusWho">{t.status[0]?.[0]}</b><span id="statusWhat">{t.status[0]?.[1]}</span><span class="dots"><i></i><i></i><i></i></span>
        </div>
      </div>
    </header>

    <section class="stage">
      <div class="wrap stage__in">
        <div class="float f1"><Blob name="orbita" size={60} bob /><span class="bubble">{t.bubbles[0]}</span></div>
        <div class="float f2"><span class="bubble">{t.bubbles[1]}</span><Blob name="cobalto" size={60} bob /></div>
        <div class="tilt">
          <Shot name="home-hero" alt={t.shotAlt} title="APX · Home" eager />
        </div>
        <p class="stage__note">{t.real.body}</p>
      </div>
    </section>


    <section class="sec" id="new">
      <div class="wrap">
        <p class="eyebrow">{t.newIn.eyebrow}</p>
        <h2 class="h2">{t.newIn.title}</h2>
        <p class="lead">{t.newIn.lead}</p>
        <div class="news">
          {
            t.newIn.items.map((n, i) => (
              <>
              {i === 1 && (
                <a class="news__pitch" href={href(t.newIn.pitch.href)}>
                  <p class="news__pitch-title">{t.newIn.pitch.title}</p>
                  <p class="news__pitch-body">{t.newIn.pitch.body}</p>
                  <span class="news__pitch-cta">{t.newIn.pitch.cta} →</span>
                  <span class="news__pitch-crew" aria-hidden="true">
                    <Blob name="cobalto" size={64} />
                    <Blob name="brasa" size={76} />
                    <Blob name="amatista" size={58} />
                    <Blob name="perla" size={70} />
                  </span>
                </a>
              )}
              <a class:list={["news__item card", `news__item--${i}`]} href={href(n.href)}>
                <div class="news__visual" aria-hidden="true">
                  {n.shot ? (
                    <Shot name={n.shot} alt="" frame={n.shot.startsWith("phone") ? "phone" : "none"} />
                  ) : (
                    n.mock && (
                      <div class="browser-mock">
                        <div class="browser-mock__tabs">
                          {n.mock.tabs.map((tab, j) => <span class:list={{ on: j === 0 }}>{tab}</span>)}
                        </div>
                        <div class="browser-mock__url">{n.mock.url}</div>
                        <div class="browser-mock__page">
                          <i /><i /><i class="short" />
                          <p class="browser-mock__who"><Blob name="cobalto" size={22} /><b>{n.mock.who}</b> {n.mock.what}</p>
                          <p class="browser-mock__hand">{n.mock.hand}</p>
                        </div>
                      </div>
                    )
                  )}
                </div>
                <div class="news__text">
                  <h3>{n.title}</h3>
                  <p>{n.body}</p>
                  <span class="news__more">{t.newIn.more} →</span>
                </div>
              </a>
              </>
            ))
          }
        </div>
      </div>
    </section>

    <section class="sec" id="crew">
      <div class="wrap">
        <p class="eyebrow">{t.crew.eyebrow}</p>
        <h2 class="h2">{t.crew.title}</h2>
        <p class="lead">{t.crew.lead}</p>
        <div class="crew-shot">
          <Shot name="crew-demo" alt={t.crew.alt} title="APX · Northwind launch plan" />
        </div>
      </div>
    </section>

    <section class="sec" id="download">
      <div class="wrap">
        <p class="eyebrow">{t.download.eyebrow}</p>
        <h2 class="h2">{t.download.title}</h2>
        <p class="lead">{t.download.lead}</p>
        <DownloadCards t={t.download} releases={releases}>
          <div class="dl__cli card">
            <div class="dl__cmds">
              <h3>{t.download.term.title}</h3>
              <p class="dl__lead">{t.download.term.lead}</p>
              {
                [
                  [t.download.term.server, installServer, "$"],
                  [t.download.term.here, install, "$"],
                  [t.download.term.windows, installWin, ">"],
                ].map(([label, cmd, prompt]) => (
                  <>
                    <p class="dl__label">{label}</p>
                    <button class="install install--block" type="button" data-copy={cmd} data-done={t.copied}>
                      <span class="dollar">{prompt}</span><span class="cmd">{cmd}</span><span class="copy">{t.copy}</span>
                    </button>
                  </>
                ))
              }
            </div>
            <div class="dl__docs">
              <Blob name="aqua" size={52} />
              <h3>{t.download.term.docs.title}</h3>
              <p>{t.download.term.docs.body}</p>
              <a class="btn btn-light" href={href(`${pre}/devices/server/`)}>{t.download.term.docs.cta} →</a>
              <p class="dl__guides">
                {t.download.guides.map(([label, to]) => <a href={href(to ?? "/")}>{label} →</a>)}
              </p>
            </div>
          </div>
        </DownloadCards>
        <div class="dl dl--rest">
          <div class="dl__note card">
            <h3>{t.download.unsigned.title}</h3>
            <p>{t.download.unsigned.body}</p>
            <dl>
              {
                t.download.unsigned.items.map(([os, how, cmd]) => (
                  <div>
                    <dt>{os}</dt>
                    <dd>
                      {how}
                      {cmd && <code class="dl__cmd">{cmd}</code>}
                    </dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="wrap">
        <p class="eyebrow">{t.steps.eyebrow}</p>
        <h2 class="h2">{t.steps.title}</h2>
        <div class="steps">
          {
            t.steps.items.map((s) => (
              <a class="step card" href={href(s.href)}>
                <span class="step__n">{s.n}</span>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
                <span class="more">{s.cta} →</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="sec" id="map">
      <div class="wrap">
        <p class="eyebrow">{t.map.eyebrow}</p>
        <h2 class="h2">{t.map.title}</h2>
        <p class="lead">{t.map.lead}</p>
        <div class="bento">
          {
            t.sections.map((s, i) => (
              <article class:list={["tile card", { wide: i === 0 || i === 5, full: i === t.sections.length - 1 }]}>
                <Blob name={s.blob as "menta"} size={56} />
                <h3>{s.title}</h3>
                <p>{s.body}</p>
                <ul>
                  {s.links.map(([label, to]) => (
                    <li>
                      <a href={href(to ?? "/")}>{label}</a>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="sec center">
      <div class="wrap narrow">
        <p class="eyebrow">{t.cli.eyebrow}</p>
        <h2 class="h2">{t.cli.title}</h2>
        <p class="lead">{t.cli.lead}</p>
        <div class="term">
          <Terminal command={lang === "es" ? 'apx chat "¿Qué tengo para hoy?"' : 'apx chat "What\'s on my plate today?"'}>
            {lang === "es"
              ? `# Home, en Acme Store
Tenés tres cosas abiertas en Acme Store:
• Lucía armó el plan del lanzamiento y espera tu ok.
• Tomás tiene el arreglo del checkout en revisión.
• Vera programó el newsletter para el viernes a las 9.
✓ Nada vence hoy.`
              : `# Home, in Acme Store
You have three open things in Acme Store:
• Lucía drafted the launch plan and is waiting for your OK.
• Tomás has the checkout fix in review.
• Vera scheduled the newsletter for Friday at 9.
✓ Nothing is due today.`}
          </Terminal>
        </div>
        <a class="btn btn-ghost" href={href(`${pre}/reference/cli/`)}>{lang === "es" ? "Todos los comandos" : "Every command"} →</a>
      </div>
    </section>

    <HomeDiscovery lang={lang} />

    <section class="final">
      <div class="wrap center">
        <div class="parade">{parade.map((b) => <Blob name={b} size={58} />)}</div>
        <p class="parade__cap">{t.final.parade}</p>
        <h2 class="final__title">{t.final.title}</h2>
        <p class="final__tag">{t.final.tag}</p>
        <p class="lead">{t.final.body}</p>
        <div class="hero__actions">
          <a class="btn btn-light" href={href(`${pre}/start/introduction/`)}>{t.getStarted} →</a>
          <a class="btn btn-ghost" href="https://github.com/agentprojectcontext/apx">GitHub</a>
          <a class="btn btn-discord" href={discord}><svg viewBox="0 0 24 24" aria-hidden="true" class="fill"><path d="M20.32 4.37A19.8 19.8 0 0 0 15.4 2.84a.07.07 0 0 0-.08.04c-.21.38-.45.87-.61 1.25a18.3 18.3 0 0 0-5.49 0 12.6 12.6 0 0 0-.62-1.25.08.08 0 0 0-.08-.04 19.7 19.7 0 0 0-4.92 1.53.07.07 0 0 0-.03.03C.53 9.05-.32 13.58.1 18.06a.08.08 0 0 0 .03.06 19.9 19.9 0 0 0 5.99 3.03.08.08 0 0 0 .08-.03c.46-.63.87-1.3 1.22-2a.08.08 0 0 0-.04-.1 13.1 13.1 0 0 1-1.87-.9.08.08 0 0 1 0-.13l.37-.29a.07.07 0 0 1 .08-.01c3.93 1.79 8.18 1.79 12.07 0a.07.07 0 0 1 .08.01l.37.29a.08.08 0 0 1 0 .13c-.6.35-1.22.65-1.87.9a.08.08 0 0 0-.04.1c.36.7.77 1.37 1.22 2a.08.08 0 0 0 .08.03 19.8 19.8 0 0 0 6-3.03.08.08 0 0 0 .03-.06c.5-5.18-.84-9.67-3.55-13.66a.06.06 0 0 0-.03-.03zM8.02 15.33c-1.18 0-2.16-1.08-2.16-2.42s.96-2.42 2.16-2.42c1.21 0 2.18 1.1 2.16 2.42 0 1.34-.96 2.42-2.16 2.42zm7.97 0c-1.18 0-2.15-1.08-2.15-2.42s.95-2.42 2.15-2.42c1.21 0 2.18 1.1 2.16 2.42 0 1.34-.95 2.42-2.16 2.42z" /></svg> {t.discord}</a>
        </div>
      </div>
    </section>

    <WebFooter lang={lang} />

    <BlobEyes />
    <script>
      for (const b of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
        b.addEventListener("click", async () => {
          await navigator.clipboard?.writeText(b.dataset.copy ?? "");
          const label = b.querySelector(".copy");
          if (!label) return;
          const was = label.textContent;
          label.textContent = b.dataset.done ?? "✓";
          setTimeout(() => {
            label.textContent = was;
          }, 1400);
        });
      }

      // The terminal button unfolds the one-line install under the hero's actions.
      const term = document.querySelector<HTMLButtonElement>(".hero__term");
      term?.addEventListener("click", () => {
        const install = document.getElementById("heroInstall");
        if (!install) return;
        install.hidden = !install.hidden;
        term.setAttribute("aria-expanded", String(!install.hidden));
      });

      // The hero's install line follows the reader's system; the icons switch it.
      const hero = document.getElementById("heroInstall");
      const setOs = (os: "unix" | "win") => {
        if (!hero) return;
        const cmd = hero.dataset[os] ?? "";
        const btn = hero.querySelector<HTMLButtonElement>("[data-copy]");
        if (btn) btn.dataset.copy = cmd;
        hero.querySelector(".cmd")!.textContent = cmd;
        hero.querySelector(".dollar")!.textContent = os === "win" ? ">" : "$";
        for (const b of hero.querySelectorAll<HTMLElement>("[data-os]")) b.setAttribute("aria-pressed", String(b.dataset.os === os));
        const label = hero.querySelector<HTMLElement>(".os__for");
        if (label) label.textContent = label.dataset[os] ?? "";
      };
      for (const b of hero?.querySelectorAll<HTMLElement>("[data-os]") ?? [])
        b.addEventListener("click", () => setOs(b.dataset.os === "win" ? "win" : "unix"));
      if (/win/i.test((navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData?.platform ?? navigator.platform)) setOs("win");

      // The hero's last word and its blobo change together.
      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const word = document.getElementById("word");
      const blobs = [...document.querySelectorAll<HTMLElement>("#heroBlob .apx-blob")];
      const words = JSON.parse(word?.dataset.words ?? "[]") as string[];
      let i = 0;
      if (!still && word && words.length > 1)
        setInterval(() => {
          i = (i + 1) % words.length;
          word.classList.remove("in");
          void word.offsetWidth;
          word.textContent = words[i] ?? "";
          word.classList.add("in");
          blobs.forEach((b, j) => {
            b.classList.toggle("on", j === i % blobs.length);
          });
        }, 2600);

      // The status line under the hero: who is doing what.
      const status = document.getElementById("status");
      const lines = JSON.parse(status?.dataset.lines ?? "[]") as [string, string][];
      const who = document.getElementById("statusWho");
      const what = document.getElementById("statusWhat");
      let s = 0;
      if (!still && who && what && lines.length > 1)
        setInterval(() => {
          s = (s + 1) % lines.length;
          status?.classList.remove("in");
          void status?.offsetWidth;
          who.textContent = lines[s]?.[0] ?? "";
          what.textContent = lines[s]?.[1] ?? "";
          status?.classList.add("in");
        }, 3200);

      // Sections rise in as they enter the screen.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries)
            if (e.isIntersecting) {
              e.target.classList.add("seen");
              io.unobserve(e.target);
            }
        },
        { rootMargin: "0px 0px -10% 0px" },
      );
      for (const el of document.querySelectorAll(".sec .wrap > *, .final .wrap > *")) io.observe(el);
    </script>
    <AnalyticsConsent />
  </body>
</html>
