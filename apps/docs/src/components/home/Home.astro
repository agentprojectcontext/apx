---
// The site's front page: a hero lit by the horizon effect, with a rotating word, the real app, what it does, the way in,
// questions, comparisons and downloads.
import logo from "../../assets/logo.png";
import blobs from "../../data/blobs.json";
import { featured } from "../../data/comparisons";
import { builtRelease, downloadHref, releasesPage } from "../../data/latest-release";
import { sitePath } from "../../doc-routes.mjs";
import { HOME, type Lang } from "../../i18n/home";
import AnalyticsConsent from "../AnalyticsConsent.astro";
import Blob from "../Blob.astro";
import BlobEyes from "../BlobEyes.astro";
import BrandMark from "../BrandMark.astro";
import OsIcon from "../OsIcon.astro";
import Shot from "../Shot.astro";
import UiIcon from "../UiIcon.astro";
import SocialIcon from "../web/SocialIcon.astro";
import WebFooter from "../web/WebFooter.astro";
import WebHeader from "../web/WebHeader.astro";
import DownloadButton from "./DownloadButton.astro";
import "./home.css";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = HOME[lang];
const href = (path: string) => sitePath(path, import.meta.env.BASE_URL);
const pre = lang === "es" ? "/es" : "";
// v2's releases are not GitHub's "Latest" while v1 shares the repo, so the scripts are served by this site.
const site = "https://apxagent.app";
const install = `curl -fsSL ${site}/install.sh | bash`;
const installWin = `irm ${site}/install.ps1 | iex`;
const installServer = `curl -fsSL ${site}/install.sh | bash -s -- --server`;
const releases = releasesPage;
const discord = "https://discord.gg/vxdZuT5WuE";
type BlobName = keyof typeof blobs;

const wordBlobs: BlobName[] = ["menta", "noche", "cobalto", "amatista", "brasa"];
const statusBlobs: BlobName[] = ["menta", "coral", "cobalto", "amatista"];
const osList = [
  { id: "mac", name: "macOS" },
  { id: "windows", name: "Windows" },
  { id: "linux", name: "Linux" },
  { id: "android", name: "Android" },
] as const;
const terms = [
  { id: "unix", cmd: install, tab: t.term.tabs.unix },
  { id: "win", cmd: installWin, tab: t.term.tabs.win },
  { id: "server", cmd: installServer, tab: t.term.tabs.server },
];
const marquee = [
  { name: "ChatGPT", brand: "openai" },
  { name: "Claude", brand: "claude" },
  { name: "Gemini", brand: "gemini" },
  { name: "Claude Code", brand: "claude" },
  { name: "Codex", brand: "codex" },
  { name: "Ollama", brand: "ollama" },
] as const;
const moreIcons = ["link", "monitor", "bot", "plug"] as const;
const localIcons = ["folder", "messageCircle", "brain", "lock"] as const;
const taskAgents: BlobName[] = ["cobalto", "amatista", "coral", "orbita"];
const pitchBlobs: BlobName[] = ["menta", "coral", "noche", "cobalto", "amatista"];
const stepBlobs: BlobName[] = ["menta", "noche", "cobalto"];
const travelBlobs: BlobName[] = ["menta", "cobalto", "amatista", "coral", "brasa", "aqua"];
const parade: BlobName[] = [
  "menta",
  "parche",
  "trino",
  "cubi",
  "nimbo",
  "papa",
  "noche",
  "kiwi",
  "gajo",
  "campana",
  "cobalto",
  "rubi",
  "trebol",
  "saturno",
  "onyx",
  "perla",
  "faro",
  "brasa",
  "aqua",
  "coral",
  "zafiro",
  "pino",
  "eclipse",
  "peon",
  "ovni",
  "amatista",
  "volcan",
  "quad",
  "cometa",
  "lila",
  "orbita",
  "caracol",
  "iris",
  "laguna",
  "carbon",
];
const cards = [
  { id: "mac", name: "macOS", blob: "amatista", tone: "violet", file: "-mac-arm64.dmg", alt: "-mac-x64.dmg" },
  { id: "windows", name: "Windows", blob: "cobalto", tone: "info", file: "-win-x64.exe" },
  {
    id: "linux",
    name: "Linux",
    blob: "brasa",
    tone: "warning",
    file: "-linux-x86_64.AppImage",
    alt: "-linux-arm64.AppImage",
  },
  { id: "android", name: "Android", blob: "menta", tone: "brand", file: "-android.apk" },
] as const;
const cliRows = [
  { id: "server", icon: "server", label: t.download.term.server, cmd: installServer },
  { id: "unix", icon: "mac", label: t.download.term.here, cmd: install },
  { id: "win", icon: "windows", label: t.download.term.windows, cmd: installWin },
] as const;
// One column per system: a step whose label is not a system (macOS's "if it says it is damaged") stays with the one above.
const systems = new Set(["macOS", "Windows", "Linux"]);
const unsignedBySystem = t.download.unsigned.items.reduce<(typeof t.download.unsigned.items)[number][][]>(
  (cols, item) => {
    if (systems.has(item[0]) || cols.length === 0) cols.push([item]);
    else cols[cols.length - 1].push(item);
    return cols;
  },
  [],
);
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href={href("/")} />
    <link rel="alternate" hreflang="es" href={href("/es/")} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(href(lang === "es" ? "/es/" : "/"), Astro.site).href} />
    <meta property="og:image" content={new URL(href("/og.jpg"), Astro.site).href} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="APX: meet your crew. AI agents that live on your computer." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(href("/og.jpg"), Astro.site).href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300..800&family=Geist+Mono:wght@400;500;600&display=swap"
    />
  </head>
  <body class="h home">
    <a class="skip-link" href="#main">{lang === "es" ? "Ir al contenido" : "Skip to content"}</a>
    <WebHeader lang={lang} />

    <main id="main">
      <section class="hero">
        <div class="hero__aura" aria-hidden="true"></div>
        <canvas class="hero__horizon" id="horizon" aria-hidden="true"></canvas>
        <div class="wrap hero__in">
          <a class="hero__pill" href="#download">
            <span class="hero__new">{t.pill.strong}</span>
            <span class="hero__on">{t.pill.rest}</span>
            <span class="hero__os">
              {
                osList.map((o, i) => (
                  <span class="hero__os-item">
                    {i > 0 && <span class="hero__os-sep" aria-hidden="true">·</span>}
                    <OsIcon name={o.id} size={13} />
                    {o.name}
                  </span>
                ))
              }
            </span>
          </a>
          <h1 class="hero__title">
            <span class="hero__line">{t.meet}</span>
            <span class="hero__line hero__line--word">
              <span class="hero__blob" id="heroBlob" aria-hidden="true">
                {wordBlobs.map((b, i) => <Blob name={b} size="100%" class={i === 0 ? "on" : ""} />)}
              </span>
              <span class="hero__word" id="word" data-words={JSON.stringify(t.words)}>{t.words[0]}</span>
            </span>
          </h1>
          <p class="hero__sub"><b>{t.sub.strong}</b> {t.sub.rest}</p>
          <div class="hero__actions">
            <DownloadButton t={t.get} releases={releases} hero />
            <button class="hero__term" type="button" aria-expanded="false" aria-controls="heroInstall">
              <UiIcon name="terminal" />{t.get.terminal}
            </button>
          </div>
          <div class="hero__dock">
          <div class="hero__install" id="heroInstall" hidden>
            <div class="hero__tabs" role="group" aria-label={t.term.label}>
              {
                terms.map((term, i) => (
                  <button type="button" data-term={term.id} aria-pressed={String(i === 0)}>
                    {term.tab[0]}
                  </button>
                ))
              }
            </div>
            {
              terms.map((term, i) => (
                <div class="hero__pane" data-pane={term.id} hidden={i !== 0}>
                  <button class="cmd" type="button" data-copy={term.cmd} data-done={t.copied}>
                    <span class="cmd__prompt" aria-hidden="true">{term.id === "win" ? ">" : "$"}</span>
                    <code class="cmd__text">{term.cmd}</code>
                    <span class="cmd__copy">{t.copy}</span>
                  </button>
                  <p class="hero__note">{term.tab[1]}</p>
                </div>
              ))
            }
          </div>
          <div class="status" id="status" data-lines={JSON.stringify(t.status)}>
            <span class="status__blob" aria-hidden="true">
              {statusBlobs.map((b, i) => <Blob name={b} size={24} class={i === 0 ? "on" : ""} />)}
            </span>
            <span class="status__text"><b id="statusWho">{t.status[0]?.[0]}</b><span id="statusWhat">{t.status[0]?.[1]}</span></span>
            <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          </div>
          </div>
        </div>
      </section>

      <section class="stage">
        <div class="wrap stage__in">
          <div class="stage__bubble stage__bubble--l" aria-hidden="true"><Blob name="coral" size={32} /><span class="stage__say">{t.bubbles[0]}</span></div>
          <div class="stage__bubble stage__bubble--r" aria-hidden="true"><span class="stage__say">{t.bubbles[1]}</span><Blob name="cobalto" size={32} /></div>
          <div class="stage__shot" data-reveal data-stage-card>
            <Shot name="home-hero" alt={t.shotAlt} frame="none" eager />
          </div>
          <p class="stage__note">{t.stageNote}</p>
        </div>
      </section>

      <section class="sec" id="what" aria-labelledby="what-title">
        <div class="wrap">
          <div class="sec-head" data-reveal>
            <p class="sec-label"><Blob name="menta" size={22} /><span class="sec-label__n">01</span><span class="sec-label__dash"></span><span>{t.what.label}</span></p>
            <h2 class="h2" id="what-title">{t.what.title}</h2>
          </div>
          <div class="bento" data-reveal>
            <article class="tile">
              <div class="tile__ui" aria-hidden="true">
                <div class="mini mini--chat">
                  <p class="mini__head"><UiIcon name="folder" size={12} />{t.what.crew.room}</p>
                  <div class="mini__msg"><Blob name="coral" size={24} /><div><b>Lucía</b> <time>9:12</time><p>{t.what.crew.lucia}</p></div></div>
                  <p class="mini__handoff"><Blob name="coral" size={14} />→<Blob name="cobalto" size={14} />{t.what.crew.handoff}</p>
                  <div class="mini__msg"><Blob name="cobalto" size={24} /><div><b>Tomás</b> <time>9:26</time><p>{t.what.crew.tomas}</p></div></div>
                  <div class="mini__msg"><Blob name="amatista" size={24} /><div><b>Vera</b> <time>9:31</time><p>{t.what.crew.vera}</p></div></div>
                </div>
              </div>
              <div class="tile__text"><h3>{t.what.crew.title}</h3><p>{t.what.crew.body}</p></div>
            </article>
            <article class="tile">
              <div class="tile__ui" aria-hidden="true">
                <div class="mini mini--models">
                  <div class="marquee">
                    {[0, 1].map(() => marquee.map((m) => <span class="chip"><BrandMark brand={m.brand} size={16} />{m.name}</span>))}
                  </div>
                  <div class="marquee marquee--back">
                    {[0, 1].map(() => t.what.models.more.map((m, i) => <span class="chip"><UiIcon name={moreIcons[i] ?? "link"} size={14} />{m}</span>))}
                  </div>
                  <p class="mini__live"><span class="live-dot"></span>{t.what.models.note}</p>
                </div>
              </div>
              <div class="tile__text"><h3>{t.what.models.title}</h3><p>{t.what.models.body}</p></div>
            </article>
            <article class="tile">
              <div class="tile__ui" aria-hidden="true">
                <div class="mini mini--routine">
                  <div class="routine">
                    <p class="routine__top"><span class="mini__mono"><UiIcon name="refreshCw" size={12} />{t.what.routine.kind}</span><span class="badge-live">{t.what.routine.active}</span></p>
                    <p class="routine__name">{t.what.routine.name}</p>
                    <p class="routine__when"><UiIcon name="clock" size={12} />{t.what.routine.when}<span class="routine__who"><Blob name="menta" size={16} />Home</span></p>
                  </div>
                  <ul class="routine__log">
                    {t.what.routine.log.map(([when, what], i) => <li class:list={{ hit: i === t.what.routine.log.length - 1 }}><span>{when}</span>{i === t.what.routine.log.length - 1 && <span class="live-dot"></span>}{what}</li>)}
                  </ul>
                </div>
              </div>
              <div class="tile__text"><h3>{t.what.routine.title}</h3><p>{t.what.routine.body}</p></div>
            </article>
            <article class="tile">
              <div class="tile__ui" aria-hidden="true">
                <div class="mini mini--tasks">
                  <p class="mini__head"><UiIcon name="listChecks" size={12} />{t.what.tasks.head}</p>
                  {
                    t.what.tasks.items.map(([task, due], i) => (
                      <p class:list={["task", { done: i === 0 }]}>
                        <span class="task__box">{i === 0 && <UiIcon name="check" size={12} />}</span>
                        <span class="task__name">{task}</span>
                        <Blob name={taskAgents[i] ?? "menta"} size={16} />
                        <span class="task__due">{due}</span>
                      </p>
                    ))
                  }
                </div>
              </div>
              <div class="tile__text"><h3>{t.what.tasks.title}</h3><p>{t.what.tasks.body}</p></div>
            </article>
            <article class="tile">
              <div class="tile__ui" aria-hidden="true">
                <div class="mini mini--browser">
                  <div class="browser__tabs">{t.what.browser.tabs.map((tab, i) => <span class:list={{ on: i === 0 }}>{tab}</span>)}</div>
                  <p class="browser__url"><UiIcon name="lock" size={12} />{t.what.browser.url}</p>
                  <div class="browser__page">
                    <i></i><i class="w70"></i><i class="w85"></i>
                    <p class="browser__who"><Blob name="cobalto" size={20} /><span><b>Tomás</b> {t.what.browser.what}</span></p>
                    <p class="browser__hand"><UiIcon name="triangleAlert" size={12} />{t.what.browser.hand}</p>
                  </div>
                </div>
              </div>
              <div class="tile__text"><h3>{t.what.browser.title}</h3><p>{t.what.browser.body}</p></div>
            </article>
            <article class="tile">
              <div class="tile__ui" aria-hidden="true">
                <div class="mini mini--local">
                  <p class="mini__head"><UiIcon name="monitor" size={12} />{t.what.local.head}</p>
                  {t.what.local.items.map((item, i) => <p class="local"><UiIcon name={localIcons[i] ?? "folder"} size={14} /><span>{item}</span><UiIcon name="check" size={14} class="local__ok" /></p>)}
                </div>
              </div>
              <div class="tile__text"><h3>{t.what.local.title}</h3><p>{t.what.local.body}</p></div>
            </article>
          </div>
        </div>
      </section>

      <section class="sec" id="new" aria-labelledby="new-title">
        <div class="wrap">
          <div class="sec-head" data-reveal>
            <p class="sec-label"><Blob name="cobalto" size={22} /><span class="sec-label__n">02</span><span class="sec-label__dash"></span><span>{t.newIn.label}</span></p>
            <h2 class="h2" id="new-title">{t.newIn.title}</h2>
            <p class="lead">{t.newIn.lead}</p>
          </div>
          <div class="feats" data-reveal>
            <div class="feats__list">
              {
                t.newIn.items.map((f, i) => (
                  <div class:list={["feat", { on: i === 0 }]} data-feat={i}>
                    <button class="feat__pick" type="button" aria-expanded={String(i === 0)} aria-controls={`feat-${i}`}>
                      <Blob name={f.blob as BlobName} size={20} />
                      <span class="feat__title">{f.title}</span>
                    </button>
                    <div class="feat__body" id={`feat-${i}`} hidden={i !== 0}>
                      <p>{f.body}</p>
                      <a href={href(f.href)}>{t.newIn.more} →</a>
                    </div>
                    <span class="feat__bar" aria-hidden="true"></span>
                  </div>
                ))
              }
            </div>
            <div class="feats__shot">
              {
                t.newIn.items.map((f, i) => (
                  <div class:list={["feats__img", { on: i === 0, feats__fan: "fan" in f }]} data-shot={i}>
                    {"fan" in f && f.fan ? (
                      f.fan.map(([shot, alt], j) => (
                        <div class:list={["fan__phone", `fan__phone--${j}`]}>
                          <Shot name={shot} alt={alt} frame="none" />
                        </div>
                      ))
                    ) : (
                      <Shot name={f.shot} alt={f.title} frame="none" />
                    )}
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section class="sec pitch">
        <div class="wrap" data-reveal>
          <div class="pitch__crew" aria-hidden="true">{pitchBlobs.map((b) => <Blob name={b} size={28} />)}</div>
          <h2 class="pitch__title">{t.pitch.title} <span>{t.pitch.rest}</span></h2>
          <p class="pitch__body">{t.pitch.body}</p>
        </div>
      </section>

      <section class="sec" id="start" aria-labelledby="start-title">
        <div class="wrap">
          <div class="sec-head" data-reveal>
            <p class="sec-label"><Blob name="coral" size={22} /><span class="sec-label__n">03</span><span class="sec-label__dash"></span><span>{t.steps.label}</span></p>
            <h2 class="h2" id="start-title">{t.steps.title}</h2>
          </div>
          <ol class="steps" data-reveal>
            {
              t.steps.items.map((s, i) => (
                <li class="step">
                  <p class="step__n"><span class="step__blob"><Blob name={stepBlobs[i] ?? "menta"} size={16} /></span><span>{s.n}</span></p>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                  <a href={href(s.href)}>{s.cta} →</a>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section class="sec" id="map" aria-labelledby="map-title">
        <div class="wrap">
          <div class="sec-head" data-reveal>
            <p class="sec-label"><Blob name="orbita" size={22} /><span class="sec-label__n">04</span><span class="sec-label__dash"></span><span>{t.map.eyebrow}</span></p>
            <h2 class="h2" id="map-title">{t.map.title}</h2>
            <p class="lead">{t.map.lead}</p>
          </div>
          <div class="guide-map" data-reveal>
            {
              t.sections.map((s) => (
                <article class="guide-card">
                  <Blob name={s.blob as BlobName} size={40} />
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                  <ul>
                    {s.links.map(([label, to]) => (
                      <li>
                        <a href={href(to ?? "/")}>{label} <span aria-hidden="true">→</span></a>
                      </li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="sec" id="terminal" aria-labelledby="terminal-title">
        <div class="wrap term-demo">
          <div class="sec-head" data-reveal>
            <p class="sec-label"><Blob name="noche" size={22} /><span class="sec-label__n">05</span><span class="sec-label__dash"></span><span>{t.cli.eyebrow}</span></p>
            <h2 class="h2" id="terminal-title">{t.cli.title}</h2>
            <p class="lead">{t.cli.lead}</p>
            <a class="term-demo__all" href={href(`${pre}/reference/cli/`)}>{t.cli.all} →</a>
          </div>
          <div class="term-demo__box" data-reveal>
            <p class="term-demo__bar"><span class="term-demo__icon"><UiIcon name="terminal" size={14} /></span>apx</p>
            <p class="visually-hidden">{t.cli.transcript}: {t.cli.demo.map((d) => `$ ${d.command} — ${d.output.map(([, line]) => line).join(" ")}`).join(" · ")}</p>
            <pre class="term-demo__screen" aria-hidden="true" data-demo={JSON.stringify(t.cli.demo)}><code>{(() => {
              const first = t.cli.demo[0];
              return first ? <><span class="term-demo__prompt">$</span> {first.command}{"\n"}{first.output.map(([kind, line]) => kind === "#" ? <><span class="term-demo__muted"># {line}</span>{"\n"}</> : kind === "✓" ? <><span class="term-demo__ok">✓ {line}</span>{"\n"}</> : <>{kind ? `${kind} ` : ""}{line}{"\n"}</>)}</> : null;
            })()}</code></pre>
          </div>
        </div>
      </section>


      <section class="sec home-questions" id="questions" aria-labelledby="questions-title">
        <div class="wrap home-questions__layout" data-reveal>
          <div class="home-questions__heading">
            <h2 class="h2" id="questions-title">{t.faq.title}</h2>
            <p class="lead">{t.faq.lead}</p>
            <div class="home-questions__blob" aria-hidden="true"><Blob name="ovni" size={64} /></div>
          </div>
          <div class="home-questions__items">
            {
              t.faq.items.map(({ question, answer, path }) => (
                <details>
                  <summary>
                    <span class="faq__q">{question}</span>
                    <span class="faq__plus" aria-hidden="true"><UiIcon name="plus" size={14} /></span>
                  </summary>
                  <div class="home-questions__answer">
                    <p>{answer}</p>
                    <a href={href(`${pre}${path}`)}>{t.faq.read} ↗</a>
                  </div>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      <section class="sec home-comparisons" id="compare" aria-labelledby="home-comparisons-title">
        <div class="wrap">
          <div class="home-comparisons__heading" data-reveal>
            <div>
              <h2 class="h2" id="home-comparisons-title">{t.compare.title}</h2>
              <p class="lead">{t.compare.lead}</p>
            </div>
            <a class="home-comparisons__all" href={href(`${pre}/compare/`)}>{t.compare.all} ↗</a>
          </div>
          <div class="home-comparisons__grid" data-reveal>
            {
              featured.map((product, i) => (
                <a class="home-comparisons__card" href={href(`${pre}/compare/${product.slug}/`)}>
                  <span class="home-comparisons__visual" aria-hidden="true">
                    <span class="pair-mark"><img src={logo.src} alt="" width="28" height="28" /></span>
                    <span class="pair-line">
                      <span class="pair-line__vs">vs</span>
                      <span class="pair-line__blob" style={`animation-delay:${-i * 1.1}s`}><Blob name={travelBlobs[i] ?? "menta"} size={20} /></span>
                    </span>
                    <span class="pair-mark home-comparisons__logo"><img src={href(`/brands/${product.logo}`)} class:list={{ "mono-mark": product.mono }} alt="" width="28" height="28" loading="lazy" /></span>
                  </span>
                  <span class="home-comparisons__body">
                    <span class="home-comparisons__name"><span class="home-comparisons__title">APX vs {product.name}</span><span class="home-comparisons__arrow" aria-hidden="true">↗</span></span>
                    <span class="home-comparisons__tag">{product.tagline[lang]}</span>
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section class="sec" id="download" aria-labelledby="download-title">
        <div class="wrap">
          <div class="sec-head" data-reveal>
            <p class="sec-label"><Blob name="aqua" size={22} /><span class="sec-label__n">06</span><span class="sec-label__dash"></span><span>{t.download.label}</span></p>
            <h2 class="h2" id="download-title">{t.download.title}</h2>
            <p class="lead">{t.download.lead}</p>
          </div>
          <div class="dlc" data-reveal>
            {
              cards.map((c) => (
                <article class="dlc__card" style={`--tone: var(--apx-${c.tone})`}>
                  <p class="dlc__top"><OsIcon name={c.id} size={30} /><span class="dlc__tag">{t.download.available}</span></p>
                  <h3>{c.name}</h3>
                  <p class="dlc__meta">{t.download.cards[c.id]}</p>
                  <a class="dlc__main" href={downloadHref(c.file)} data-file={c.file} data-release={builtRelease}>{t.download.getFor} {c.name} <span aria-hidden="true">↓</span></a>
                  {"alt" in c ? <a class="dlc__alt" href={downloadHref(c.alt)} data-file={c.alt} data-release={builtRelease}>{t.download.alt[c.id as "mac" | "linux"]}</a> : <span class="dlc__alt" />}
                  <span class="dlc__blob" aria-hidden="true"><Blob name={c.blob} size={64} /></span>
                </article>
              ))
            }
          </div>
          <div class="dl-pair" data-reveal>
          <div class="cli">
            <div class="cli__head">
              <span class="cli__icon"><UiIcon name="terminal" size={18} /></span>
              <div><h3>{t.download.term.title}</h3><p>{t.download.term.lead}</p></div>
            </div>
            <div class="cli__tabs" role="group" aria-label={t.download.term.label}>
              {cliRows.map((row) => <button type="button" data-cli={row.id} aria-pressed={String(row.id === "server")}>{row.icon === "server" ? <UiIcon name="server" size={14} /> : <OsIcon name={row.icon} size={14} />}{t.download.term.tabs[row.id]}</button>)}
            </div>
            {
              cliRows.map((row) => (
                <div class="cli__row" data-cli-pane={row.id} hidden={row.id !== "server"}>
                  <code class="cli__cmd"><span aria-hidden="true">{row.icon === "windows" ? "> " : "$ "}</span>{row.cmd}</code>
                  <button class="cli__copy" type="button" data-copy={row.cmd} data-done={t.copied}><UiIcon name="copy" size={12} /><span class="cmd__copy">{t.copy}</span></button>
                  <p class="cli__note">{row.label}</p>
                </div>
              ))
            }
          </div>
            <article class="dl-server">
              <p class="dl-server__title"><Blob name="aqua" size={36} /><span>{t.download.term.docs.title}</span></p>
              <p class="dl-server__body">{t.download.term.docs.body}</p>
              <a class="btn btn-light dl-server__cta" href={href(`${pre}/devices/server/`)}>{t.download.term.docs.cta} →</a>
              <p class="dl-server__links">
                {t.download.term.guides.map(([label, to]) => <a href={href(to ?? "/")}>{label} →</a>)}
                <a href={releases}>{t.download.releases} ↗</a>
              </p>
            </article>
          </div>
          <article class="dl-unsigned" data-reveal>
            <h3>{t.download.unsigned.title}</h3>
            <p>{t.download.unsigned.body}</p>
            <div class="dl-unsigned__cols">
              {
                unsignedBySystem.map((steps) => (
                  <dl>
                    {steps.map(([os, how, cmd]) => (
                      <div>
                        <dt>{os}</dt>
                        <dd>{how}{cmd && <code>{cmd}</code>}</dd>
                      </div>
                    ))}
                  </dl>
                ))
              }
            </div>
          </article>
        </div>
      </section>

      <section class="final">
        <div class="wrap">
          <div class="parade" aria-hidden="true">{parade.map((b) => <Blob name={b} size="var(--parade-size)" />)}</div>
          <p class="parade__cap">{t.final.parade}</p>
          <h2 class="final__title">{t.final.title}</h2>
          <p class="final__tag">{t.final.tag}</p>
          <p class="final__body">{t.final.body}</p>
          <div class="final__actions">
            <a class="btn btn-light" href="#download">{t.getApp}</a>
            <a class="btn btn-discord" href={discord}><SocialIcon name="Discord" size={20} />{t.final.discord}</a>
          </div>
        </div>
      </section>
    </main>

    <WebFooter lang={lang} />

    <BlobEyes />
    <script>
      import { fillLatest } from "../latest-release";
      import { startReveal } from "../web/reveal";
      import { startHorizon } from "./horizon";
      import { startTermDemo } from "./term-demo";

      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
      startReveal();
      // The horizon follows the stage card: its edges and top, as fractions of the canvas, and its corner radius.
      const canvas = document.getElementById("horizon") as HTMLCanvasElement | null;
      const stage = document.querySelector<HTMLElement>("[data-stage-card]");
      if (
        canvas &&
        stage &&
        startHorizon(canvas, () => {
          const c = canvas.getBoundingClientRect();
          const s = stage.getBoundingClientRect();
          if (!c.width || !c.height) return null;
          const radius = Number.parseFloat(getComputedStyle(stage).borderTopLeftRadius) || 16;
          return [
            (s.left - c.left) / c.width,
            (s.right - c.left) / c.width,
            (s.top - c.top) / c.height,
            radius / c.height,
            s.height / c.height,
          ];
        })
      )
        document.querySelector(".hero")?.classList.add("has-horizon");
      fillLatest(document.querySelectorAll<HTMLAnchorElement>(".dlc a[data-file]"));

      for (const b of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
        b.addEventListener("click", async () => {
          try {
            await navigator.clipboard?.writeText(b.dataset.copy ?? "");
          } catch {}
          const label = b.querySelector(".cmd__copy");
          if (!label) return;
          const was = label.textContent;
          label.textContent = b.dataset.done ?? "✓";
          setTimeout(() => {
            label.textContent = was;
          }, 1500);
        });
      }

      const demo = document.querySelector<HTMLElement>(".term-demo__screen");
      if (demo) startTermDemo(demo);

      // The download section's install lines: one system at a time, the reader's own first (a server when unknown).
      const cliTabs = [...document.querySelectorAll<HTMLElement>("[data-cli]")];
      const pickCli = (id: string) => {
        for (const b of cliTabs) b.setAttribute("aria-pressed", String(b.dataset.cli === id));
        for (const p of document.querySelectorAll<HTMLElement>("[data-cli-pane]")) p.hidden = p.dataset.cliPane !== id;
      };
      for (const b of cliTabs) b.addEventListener("click", () => pickCli(b.dataset.cli ?? "server"));
      const platform = (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData?.platform ?? navigator.platform;
      if (/android|iphone|ipad/i.test(navigator.userAgent)) pickCli("server");
      else if (/win/i.test(platform)) pickCli("win");
      else if (/mac|linux/i.test(platform)) pickCli("unix");

      // The terminal button unfolds the install lines under the hero's actions, one tab per place.
      const term = document.querySelector<HTMLButtonElement>(".hero__term");
      const install = document.getElementById("heroInstall");
      term?.addEventListener("click", () => {
        if (!install) return;
        install.hidden = !install.hidden;
        term.setAttribute("aria-expanded", String(!install.hidden));
        document.getElementById("status")?.classList.toggle("is-away", !install.hidden);
      });
      const pickTerm = (id: string) => {
        for (const b of install?.querySelectorAll<HTMLElement>("[data-term]") ?? []) b.setAttribute("aria-pressed", String(b.dataset.term === id));
        for (const p of install?.querySelectorAll<HTMLElement>("[data-pane]") ?? []) p.hidden = p.dataset.pane !== id;
      };
      for (const b of install?.querySelectorAll<HTMLElement>("[data-term]") ?? []) b.addEventListener("click", () => pickTerm(b.dataset.term ?? "unix"));
      if (/win/i.test((navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData?.platform ?? navigator.platform)) pickTerm("win");

      // The hero's last word and its blobo change together; the status line says who is doing what.
      const word = document.getElementById("word");
      const wordBlobs = [...document.querySelectorAll<HTMLElement>("#heroBlob .apx-blob")];
      const words = JSON.parse(word?.dataset.words ?? "[]") as string[];
      let wi = 0;
      if (!still && word && words.length > 1)
        setInterval(() => {
          wi = (wi + 1) % words.length;
          word.classList.remove("in");
          void word.offsetWidth;
          word.textContent = words[wi] ?? "";
          word.classList.add("in");
          wordBlobs.forEach((b, j) => {
            b.classList.toggle("on", j === wi % wordBlobs.length);
          });
        }, 2600);
      const status = document.getElementById("status");
      const lines = JSON.parse(status?.dataset.lines ?? "[]") as [string, string][];
      const who = document.getElementById("statusWho");
      const what = document.getElementById("statusWhat");
      const statusBlobs = [...document.querySelectorAll<HTMLElement>(".status__blob .apx-blob")];
      let si = 0;
      if (!still && status && who && what && lines.length > 1)
        setInterval(() => {
          si = (si + 1) % lines.length;
          status.classList.remove("in");
          void status.offsetWidth;
          who.textContent = lines[si]?.[0] ?? "";
          what.textContent = lines[si]?.[1] ?? "";
          status.classList.add("in");
          statusBlobs.forEach((b, j) => {
            b.classList.toggle("on", j === si);
          });
        }, 3400);

      // What's new: one item open at a time, moving on every 7 s until the reader picks one.
      const feats = [...document.querySelectorAll<HTMLElement>(".feat")];
      const shots = [...document.querySelectorAll<HTMLElement>(".feats__img")];
      let fi = 0;
      let timer = 0;
      const showFeat = (i: number) => {
        fi = i;
        feats.forEach((f, j) => {
          const on = j === i;
          f.classList.toggle("on", on);
          f.querySelector(".feat__pick")?.setAttribute("aria-expanded", String(on));
          const body = f.querySelector<HTMLElement>(".feat__body");
          if (body) body.hidden = !on;
          const bar = f.querySelector<HTMLElement>(".feat__bar");
          if (bar && on) {
            bar.style.animation = "none";
            void bar.offsetWidth;
            bar.style.animation = "";
          }
        });
        shots.forEach((s, j) => {
          s.classList.toggle("on", j === i);
        });
      };
      const restart = () => {
        clearInterval(timer);
        if (!still) timer = window.setInterval(() => showFeat((fi + 1) % feats.length), 7000);
      };
      feats.forEach((f, i) => {
        f.querySelector(".feat__pick")?.addEventListener("click", () => {
          showFeat(i);
          restart();
        });
      });
      restart();
    </script>
    <AnalyticsConsent />
  </body>
</html>
