---
// A blobo: the body image with its eyes drawn on top. BlobEyes.astro (once per page) makes the eyes blink and follow
// the pointer, as they do in the panel and on the site.
import type { ImageMetadata } from "astro";
import blobs from "../data/blobs.json";

interface Props {
  name: keyof typeof blobs;
  size?: number | string;
  class?: string;
  bob?: boolean;
  style?: string;
}

const bodies = import.meta.glob<ImageMetadata>("../assets/blobs/*.webp", { eager: true, import: "default" });
const { name, size = 48, class: cls = "", bob = false, style = "" } = Astro.props;
const preset = blobs[name] ?? blobs.menta;
const body = bodies[`../assets/blobs/${name}.webp`] ?? bodies["../assets/blobs/menta.webp"];
const dim = typeof size === "number" ? `${size}px` : size;
const [e0, e1] = preset.eyes;
const cx = e0 && e1 ? (e0.x + e1.x + e1.w) / 2 / 256 : 0.5;
const cy = e0 ? (e0.y + e0.h / 2) / 256 : 0.5;
---

<span
  class:list={["apx-blob", cls, { bob }]}
  style={`width:${dim};height:${dim};${style}`}
  data-cx={cx.toFixed(3)}
  data-cy={cy.toFixed(3)}
  aria-hidden="true"
>
  <img src={body?.src} alt="" decoding="async" loading="lazy" width="256" height="256" />
  {
    preset.eyes.length > 0 && (
      <svg viewBox="0 0 256 256">
        {preset.eyes.map((e) => (
          <rect class="eye" x={e.x} y={e.y} width={e.w} height={e.h} rx={e.rx} fill={preset.eyeColor} />
        ))}
      </svg>
    )
  }
</span>

<style>
  .apx-blob {
    position: relative;
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
  }
  .apx-blob img {
    width: 100%;
    height: 100%;
    margin: 0;
    pointer-events: none;
    user-select: none;
  }
  .apx-blob svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .apx-blob :global(.eye) {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.09s;
  }
  .bob {
    animation: apx-bob 3.6s ease-in-out infinite;
  }
  @keyframes apx-bob {
    0%,
    100% {
      transform: translateY(0) rotate(0);
    }
    50% {
      transform: translateY(-5%) rotate(-2deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bob {
      animation: none;
    }
  }
</style>
