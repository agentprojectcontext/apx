---
import logo from "../../assets/logo.png";
import { comparisons, featuredComparison } from "../../data/comparisons";
import { sitePath } from "../../doc-routes.mjs";
import { HOME, type Lang } from "../../i18n/home";
import Blob from "../Blob.astro";
import UiIcon from "../UiIcon.astro";
import SocialIcon from "./SocialIcon.astro";
import "./web.css";

interface Props {
  lang: Lang;
  route?: string;
}
const { lang, route = "/" } = Astro.props;
const t = HOME[lang];
const pre = lang === "es" ? "/es" : "";
const href = (path: string) => sitePath(path, import.meta.env.BASE_URL);
const comparing = route.startsWith("/compare/");
// The guide's sections, as on the docs; these pages render their own header, so only Compare is ever current here.
const docLinks = [
  ["/start/introduction/", t.nav.start],
  ["/concepts/agents/", t.nav.ideas],
  ["/office/chat/", t.nav.office],
  ["/channels/overview/", t.nav.channels],
  ["/reference/cli/", t.nav.cli],
] as const;
// The Compare menu: the newest comparison as a card, a few more beside it, and the way to all of them.
const featured = comparisons.find((c) => c.slug === featuredComparison) ?? comparisons[0];
const listed = comparisons.filter((c) => c !== featured).slice(0, 4);
const tones = ["warm", "dusk", "sea"] as const;
---
<script is:inline>
  (() => {
    let theme = "";
    try { theme = localStorage.getItem("starlight-theme") || ""; } catch {}
    const root = document.documentElement;
    root.dataset.theme = theme === "light" || theme === "dark" ? theme : matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
    root.classList.add("js");
  })();
</script>
<nav class="web-header" id="nav" aria-label={t.nav.main}>
  <div class="wrap nav__in">
    <a class="brand" href={href(`${pre}/`)}><img src={logo.src} alt="" width="26" height="26" /><span>APX</span><span class="brand__v" aria-hidden="true">v2</span></a>
    <div class="nav__links" id="navLinks">
      {docLinks.map(([path, label]) => <a href={href(`${pre}${path}`)}>{label}</a>)}
      <div class="nav__cmp">
        <a class="nav__cmp-link" href={href(`${pre}/compare/`)} aria-current={comparing ? "page" : undefined}>
          {t.nav.compare}<svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" /></svg>
        </a>
        {
          featured && (
            <div class="nav__menu">
              <div class="nav__menu-card">
                <div class="nav__menu-grid">
                  <a class="nav__feat" href={href(`${pre}/compare/${featured.slug}/`)}>
                    <span class="nav__feat-new">{t.nav.fresh}</span>
                    <span class="nav__feat-blob" aria-hidden="true"><Blob name="menta" size={64} /></span>
                    <span class="nav__feat-name">APX vs {featured.name}</span>
                    <span class="nav__feat-tag">{featured.tagline[lang]}</span>
                  </a>
                  <ul class="nav__menu-list">
                    {listed.map((c, i) => (
                      <li>
                        <a href={href(`${pre}/compare/${c.slug}/`)}>
                          <span class:list={["nav__menu-mark", `tone-${tones[i % tones.length]}`]} aria-hidden="true">
                            <span><img src={href(`/brands/${c.logo}`)} class:list={["nav__menu-logo", { "mono-mark": c.mono }]} alt="" width="18" height="18" loading="lazy" /></span>
                          </span>
                          <span class="nav__menu-text"><b>APX vs {c.name}</b><span>{c.tagline[lang]}</span></span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
                <p class="nav__menu-foot"><span>{t.nav.compareNote}</span><a href={href(`${pre}/compare/#comparisons`)}>{t.nav.compareAll} →</a></p>
              </div>
            </div>
          )
        }
      </div>
      <a href={href(`${pre}/#questions`)}>{t.nav.questions}</a>
      <a class="nav__sheet-get" href={href(`${pre}/#download`)}>{t.getApp}</a>
    </div>
    <div class="nav__cta">
      <div class="lang" role="group" aria-label={t.langLabel}>
        <a href={href(route)} class:list={{ on: lang === "en" }} hreflang="en" lang="en">EN</a>
        <a href={href(`/es${route}`)} class:list={{ on: lang === "es" }} hreflang="es" lang="es">ES</a>
      </div>
      <button class="icon-btn" id="theme" type="button" aria-label={t.themeLabel} title={t.themeLabel}>
        <UiIcon name="sun" class="sun" /><UiIcon name="moon" class="moon" />
      </button>
      <a class="icon-btn web-repo" href="https://github.com/agentprojectcontext/apx" aria-label="GitHub" title="GitHub"><SocialIcon name="GitHub" size={17} /></a>
      <a class="btn btn-discord" href="https://discord.gg/vxdZuT5WuE" aria-label="Discord" title="Discord"><SocialIcon name="Discord" size={18} /><span class="lbl">Discord</span></a>
      <a class="btn btn-light nav__get" href={href(`${pre}/#download`)} aria-label={t.getApp} title={t.getApp}>
        <UiIcon name="download" /><span class="lbl">{t.getApp}</span>
      </a>
      <button class="icon-btn nav__toggle" type="button" aria-label={t.nav.menu} aria-expanded="false" aria-controls="navLinks"><span></span><span></span></button>
    </div>
  </div>
</nav>
<script>
  const nav = document.getElementById("nav");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav__toggle");
  const open = (on: boolean) => {
    nav?.toggleAttribute("data-open", on);
    toggle?.setAttribute("aria-expanded", String(on));
  };
  toggle?.addEventListener("click", () => open(!nav?.hasAttribute("data-open")));
  for (const link of nav?.querySelectorAll(".nav__links a") ?? []) link.addEventListener("click", () => open(false));
  addEventListener("keydown", (e) => {
    if (e.key === "Escape" && nav?.hasAttribute("data-open")) {
      open(false);
      toggle?.focus();
    }
  });
  // At the very top the header is a fade over the page; once the page moves it becomes a bar.
  const onScroll = () => nav?.toggleAttribute("data-scrolled", scrollY > 24);
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();
  document.getElementById("theme")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem("starlight-theme", next); } catch {}
  });
</script>
