---
import logo from "../../assets/logo.png";
import { sitePath } from "../../doc-routes.mjs";
import { HOME, type Lang } from "../../i18n/home";
import UiIcon from "../UiIcon.astro";
import SocialIcon from "./SocialIcon.astro";
import "./web.css";

interface Props {
  lang: Lang;
  route?: string;
}
const { lang, route = "/" } = Astro.props;
const t = HOME[lang];
const pre = lang === "es" ? "/es" : "";
const href = (path: string) => sitePath(path, import.meta.env.BASE_URL);
const links = [
  ["/#new", t.nav.product],
  ["/#start", t.nav.start],
  ["/compare/", t.nav.compare],
  ["/start/introduction/", t.nav.docs],
] as const;
const current = (path: string) => (path === "/compare/" && route.startsWith("/compare/") ? "page" : undefined);
---
<script is:inline>
  (() => {
    let theme = "";
    try { theme = localStorage.getItem("starlight-theme") || ""; } catch {}
    const root = document.documentElement;
    root.dataset.theme = theme === "light" || theme === "dark" ? theme : matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
    root.classList.add("js");
  })();
</script>
<nav class="web-header" id="nav" aria-label={t.nav.main}>
  <div class="wrap nav__in">
    <a class="brand" href={href(`${pre}/`)}><img src={logo.src} alt="" width="26" height="26" /><span>APX</span><span class="brand__v" aria-hidden="true">v2</span></a>
    <div class="nav__links" id="navLinks">
      {links.map(([path, label]) => <a href={href(`${pre}${path}`)} aria-current={current(path)}>{label}</a>)}
      <a class="nav__sheet-get" href={href(`${pre}/#download`)}>{t.getApp}</a>
    </div>
    <div class="nav__cta">
      <div class="lang" role="group" aria-label={t.langLabel}>
        <a href={href(route)} class:list={{ on: lang === "en" }} hreflang="en" lang="en">EN</a>
        <a href={href(`/es${route}`)} class:list={{ on: lang === "es" }} hreflang="es" lang="es">ES</a>
      </div>
      <button class="icon-btn" id="theme" type="button" aria-label={t.themeLabel} title={t.themeLabel}>
        <UiIcon name="sun" class="sun" /><UiIcon name="moon" class="moon" />
      </button>
      <a class="icon-btn web-repo" href="https://github.com/agentprojectcontext/apx" aria-label="GitHub" title="GitHub"><SocialIcon name="GitHub" size={17} /></a>
      <a class="btn btn-discord" href="https://discord.gg/vxdZuT5WuE" aria-label="Discord" title="Discord"><SocialIcon name="Discord" size={18} /><span class="lbl">Discord</span></a>
      <a class="btn btn-light nav__get" href={href(`${pre}/#download`)} aria-label={t.getApp} title={t.getApp}>
        <UiIcon name="download" /><span class="lbl">{t.getApp}</span>
      </a>
      <button class="icon-btn nav__toggle" type="button" aria-label={t.nav.menu} aria-expanded="false" aria-controls="navLinks"><span></span><span></span></button>
    </div>
  </div>
</nav>
<script>
  const nav = document.getElementById("nav");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav__toggle");
  const open = (on: boolean) => {
    nav?.toggleAttribute("data-open", on);
    toggle?.setAttribute("aria-expanded", String(on));
  };
  toggle?.addEventListener("click", () => open(!nav?.hasAttribute("data-open")));
  for (const link of nav?.querySelectorAll(".nav__links a") ?? []) link.addEventListener("click", () => open(false));
  addEventListener("keydown", (e) => {
    if (e.key === "Escape" && nav?.hasAttribute("data-open")) {
      open(false);
      toggle?.focus();
    }
  });
  document.getElementById("theme")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem("starlight-theme", next); } catch {}
  });
</script>
