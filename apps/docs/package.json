{
  "name": "@apx/docs",
  "version": "0.0.0",
  "private": true,
  "description": "The APX documentation site (Astro + Starlight). Installs on its own: cd apps/docs && pnpm install --ignore-workspace.",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "astro dev --port 7450",
    "build": "astro build",
    "preview": "astro preview --port 7450",
    "shots": "node --no-warnings scripts/shots.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/starlight": "^0.42.5",
    "astro": "^7.3.0",
    "sharp": "^0.34.5"
  }
}
