{
  "name": "@apx/artifact-worker",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "pnpm build && wrangler dev",
    "build": "pnpm --filter @apx/artifact-viewer build && node scripts/embed-viewer.ts && wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test src/*.test.ts"
  },
  "dependencies": {
    "@apx/protocol": "workspace:*"
  },
  "devDependencies": {
    "@apx/config": "workspace:*",
    "@cloudflare/workers-types": "5.20261113.1",
    "wrangler": "4.162.0",
    "miniflare": "5.20261113.0-beta"
  }
}
