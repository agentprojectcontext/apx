{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apx-public-artifacts",
  "main": ".generated/index.ts",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "preview_urls": false,
  "rules": [{ "type": "Text", "globs": ["**/viewer-modules/*.txt"], "fallthrough": true }],
  "vars": { "FIREBASE_PROJECT": "apx-agents" },
  "r2_buckets": [{ "binding": "COPIES", "bucket_name": "apx-public-artifacts" }],
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNTS", "class_name": "PublicationAccount" },
      { "name": "BUDGET", "class_name": "PublicationBudget" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PublicationAccount", "PublicationBudget"] }],
  "ratelimits": [{ "name": "IP_LIMIT", "namespace_id": "24601", "simple": { "limit": 120, "period": 60 } }],
  "observability": { "enabled": false }
}
