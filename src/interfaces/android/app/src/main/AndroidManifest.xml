<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Not for dialling out: the socket's reconnect ladder asks whether there
         is any network at all before it retries, and wakes on the callback
         instead of on a timer. A phone away from the daemon used to retry
         every 15 s all day. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- So the notification socket survives a reboot. Without it APX is silent
         from the moment the phone restarts until someone opens the app, and
         nothing about that looks broken from the outside. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- A foreground service typed `location` is what lets APX keep reading
         the position while the phone is in a pocket or a dock, WITHOUT asking
         for ACCESS_BACKGROUND_LOCATION: the ongoing notification is the
         permission model. Tracking runs only while a trip is active. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Asked for from the native menu and nowhere else: on this phone Android
         holds back the trip's start and end events until the owner exempts APX
         by hand, and that is a system decision, not one an app may make for
         them. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="apx" android:host="pair" />
            </intent-filter>
            <intent-filter android:label="Compartir viaje con APX">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".MascotOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled floating APX mascot and live message indicator" />
        </service>

        <service
            android:name=".TripLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <service
            android:name=".MapsNavigationListenerService"
            android:exported="false"
            android:label="Detección de viajes APX"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".CarMessageActionReceiver"
            android:exported="false" />

        <!-- exported=true because both of these are SYSTEM broadcasts: the
             sender is Android, not APX, and a non-exported receiver is never
             handed them. MY_PACKAGE_REPLACED is the app's own update, which
             force-stops it and leaves the service down. -->
        <receiver
            android:name=".StartupReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
