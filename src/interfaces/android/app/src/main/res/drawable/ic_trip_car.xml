<?xml version="1.0" encoding="utf-8"?>
<!--
  The trip banner's mark. A drawn car rather than the 🚗 emoji: the emoji is
  rendered by whichever font the OEM ships, so it changed shape and colour per
  device and never matched the brand green next to it.

  Wheels are cut in the banner's own background colour so they read as holes at
  the size this is actually shown (28dp), where a stroked outline would blur.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="28dp"
    android:height="28dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- cabin -->
    <path
        android:fillColor="#3AE7B0"
        android:pathData="M7.3,6.1 C7.7,5.3 8.4,4.8 9.3,4.8 L14.7,4.8 C15.6,4.8 16.3,5.3 16.7,6.1 L18.6,10.3 L5.4,10.3 Z" />
    <!-- body -->
    <path
        android:fillColor="#3AE7B0"
        android:pathData="M3.4,12.6 C3.4,11.4 4.4,10.4 5.6,10.4 L18.4,10.4 C19.6,10.4 20.6,11.4 20.6,12.6 L20.6,15.9 C20.6,16.5 20.1,17 19.5,17 L4.5,17 C3.9,17 3.4,16.5 3.4,15.9 Z" />
    <!-- wheel wells, punched in the banner ground -->
    <path
        android:fillColor="#153028"
        android:pathData="M7.2,14.9 m-2.1,0 a2.1,2.1 0 1,0 4.2,0 a2.1,2.1 0 1,0 -4.2,0" />
    <path
        android:fillColor="#153028"
        android:pathData="M16.8,14.9 m-2.1,0 a2.1,2.1 0 1,0 4.2,0 a2.1,2.1 0 1,0 -4.2,0" />
    <!-- windows -->
    <path
        android:fillColor="#153028"
        android:pathData="M8.5,6.6 L11.3,6.6 L11.3,9.2 L7.3,9.2 Z" />
    <path
        android:fillColor="#153028"
        android:pathData="M12.7,6.6 L15.5,6.6 L16.7,9.2 L12.7,9.2 Z" />
</vector>
