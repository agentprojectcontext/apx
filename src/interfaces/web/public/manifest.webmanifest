{
  "name": "APX",
  "short_name": "APX",
  "description": "Your agents, on your phone.",
  "id": "/",
  "start_url": "/m/chat",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "theme_color": "#0a0a0a",
  "background_color": "#0a0a0a",
  "icons": [
    { "src": "/favicon/dark/android-chrome-192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/favicon/dark/android-chrome-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/favicon/dark/android-chrome-192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon/dark/android-chrome-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Chats", "url": "/m/chat" },
    { "name": "Tasks", "url": "/m/tasks" },
    { "name": "Commitments", "url": "/m/commitments" },
    { "name": "Panel", "url": "/" }
  ]
}
