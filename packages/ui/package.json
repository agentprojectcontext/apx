{
  "name": "@apx/ui",
  "version": "0.1.0",
  "private": true,
  "description": "APX design system — one component set, two looks (minimal · classic), light and dark.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./marks": {
      "types": "./dist/marks.d.ts",
      "import": "./dist/marks.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node scripts/build.mjs && node --test \"test/*.test.ts\"",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "blobs": "node scripts/export-blobs.mjs"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2"
  }
}
