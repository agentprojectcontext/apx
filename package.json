{
  "name": "apx-v2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "pnpm --filter @apx/core dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm -r --if-present test",
    "check:private": "node scripts/check-private-terms.ts",
    "check:schema": "node --no-warnings apps/core/scripts/schema.ts --check",
    "preflight": "pnpm check:private && pnpm check:schema && pnpm lint && pnpm typecheck && pnpm test",
    "app": "node scripts/app.ts",
    "build:web": "pnpm --filter @apx/ui build && pnpm --filter @apx/web build",
    "e2e": "pnpm build:web && playwright test --project chromium",
    "e2e:desktop": "pnpm build:web && pnpm --filter @apx/desktop build && playwright test --project desktop",
    "perf": "pnpm build:web && node --no-warnings scripts/perf.ts",
    "verify": "pnpm preflight && pnpm e2e && pnpm e2e:desktop && node --no-warnings scripts/perf.ts",
    "package": "node scripts/package.ts",
    "package:mac": "node scripts/package.ts mac",
    "package:linux": "node scripts/package.ts linux",
    "package:win": "node scripts/package.ts win"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.0",
    "typescript": "^7.0.2"
  }
}
