{
  "name": "apx-v2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "pnpm --filter @apx/core dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm check:tests && pnpm -r --if-present test && pnpm test:mobile && node --test \"scripts/*.test.ts\"",
    "test:mobile": "npm --prefix apps/mobile test",
    "test:coverage": "node scripts/test-coverage.ts",
    "test:coverage:all": "node scripts/test-coverage.ts --e2e",
    "test:coverage:all:strict": "node scripts/test-coverage.ts --e2e --strict",
    "test:coverage:strict": "node scripts/test-coverage.ts --strict",
    "check:tests": "node scripts/test-quality.ts",
    "check:private": "node scripts/check-private-terms.ts",
    "check:commits": "node scripts/check-private-terms.ts --commits",
    "check:schema": "node --no-warnings apps/core/scripts/schema.ts --check",
    "preflight": "pnpm preflight:static && pnpm test",
    "preflight:static": "pnpm check:private && pnpm check:schema && pnpm lint && pnpm typecheck && pnpm check:tests",
    "app": "node scripts/app.ts",
    "build:web": "pnpm --filter @apx/ui build && pnpm --filter @apx/web build",
    "e2e": "pnpm build:web && playwright test --project chromium",
    "e2e:desktop": "pnpm build:web && pnpm --filter @apx/desktop build && playwright test --project desktop",
    "perf": "pnpm build:web && node --no-warnings scripts/perf.ts",
    "tools:review": "node --no-warnings scripts/tool-review.ts",
    "verify": "pnpm preflight && pnpm test:coverage:all && node --no-warnings scripts/perf.ts",
    "release:check": "node scripts/release-check.ts",
    "package": "node scripts/package.ts",
    "package:mac": "node scripts/package.ts mac",
    "package:linux": "node scripts/package.ts linux",
    "package:win": "node scripts/package.ts win"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.0",
    "typescript": "^7.0.2",
    "typescript-parser": "npm:typescript@5.9.3"
  }
}
