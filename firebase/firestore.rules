rules_version = '2';

// APX telemetry (apps/core/src/telemetry.ts). Installs write without an account, so these rules are the whole guard:
// only the known shapes, times stamped by the server, steps that never move once stamped, and no reads or deletes from
// outside (the console and the report script read with the owner's credentials). See rules/DECISIONS.md#d-092.
service cloud.firestore {
  match /databases/{database}/documents {
    function isUuid(id) {
      return id.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$');
    }
    function short(v, n) {
      return v is string && v.size() > 0 && v.size() <= n;
    }
    function info(d) {
      return short(d.version, 32) && short(d.os, 16) && short(d.arch, 16)
        && d.channel in ['source', 'bundle', 'app', 'other', 'test']
        && (!('usage' in d) || d.usage is bool);
    }
    // A step that changed is stamped with this request's time; the ones stamped before stay as they were.
    function stamped(before, after, s, again) {
      return !(s in after) ? !(s in before)
        : (s in before && after[s] == before[s]) || after[s] == request.time && (again || !(s in before));
    }
    function count(v) {
      return v is int && v >= 0 && v <= 1000000000000;
    }

    match /installs/{id} {
      allow create: if isUuid(id)
        && request.resource.data.keys().hasOnly(['first_version', 'version', 'os', 'arch', 'channel', 'usage', 'stages', 'created', 'updated_at'])
        && request.resource.data.keys().hasAll(['first_version', 'version', 'os', 'arch', 'channel', 'stages', 'created', 'updated_at'])
        && info(request.resource.data) && short(request.resource.data.first_version, 32)
        && request.resource.data.created == request.time
        && request.resource.data.updated_at == request.time
        && request.resource.data.stages.keys().hasOnly(['installed'])
        && request.resource.data.stages.installed == request.time;

      allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['version', 'os', 'arch', 'channel', 'usage', 'stages', 'updated_at'])
        && info(request.resource.data)
        && request.resource.data.updated_at == request.time
        && request.resource.data.stages.keys().hasOnly(['installed', 'opened', 'consent', 'setup', 'first_run', 'updated'])
        && stamped(resource.data.stages, request.resource.data.stages, 'installed', false)
        && stamped(resource.data.stages, request.resource.data.stages, 'opened', false)
        && stamped(resource.data.stages, request.resource.data.stages, 'setup', false)
        && stamped(resource.data.stages, request.resource.data.stages, 'first_run', false)
        && stamped(resource.data.stages, request.resource.data.stages, 'consent', true)
        && stamped(resource.data.stages, request.resource.data.stages, 'updated', true);

      allow read, delete: if false;

      // One usage report per install and UTC day, sent only after the owner said yes.
      match /days/{day} {
        allow create: if day.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
          && exists(/databases/$(database)/documents/installs/$(id))
          && request.resource.data.keys().hasOnly(['version', 'at', 'tokens_in', 'tokens_out', 'runs', 'projects', 'agents', 'channels', 'routines'])
          && request.resource.data.keys().hasAll(['version', 'at', 'tokens_in', 'tokens_out', 'runs', 'projects', 'agents', 'channels', 'routines'])
          && short(request.resource.data.version, 32)
          && request.resource.data.at == request.time
          && count(request.resource.data.tokens_in) && count(request.resource.data.tokens_out)
          && count(request.resource.data.runs) && count(request.resource.data.projects)
          && count(request.resource.data.agents) && count(request.resource.data.channels)
          && count(request.resource.data.routines);
        allow read, update, delete: if false;
      }
    }
  }
}
