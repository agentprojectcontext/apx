---
/**
 * V2Banner.astro — Starlight's Banner slot, on every page: a one-line note that
 * APX v1 is no longer maintained and APX v2 replaces it (/apx/), then the page's own `banner`
 * frontmatter, if it has one, through Starlight's default component.
 */
import Default from '@astrojs/starlight/components/Banner.astro';

const es = Astro.locals.starlightRoute.lang === 'es';
const v2 = es ? '/apx/es/' : '/apx/';
const upgrade = es ? '/apx/es/start/from-v1/#actualizar-desde-v1' : '/apx/start/from-v1/#upgrade-from-v1';
---

<div class="apx-v2-banner">
	<span class="tag">{es ? 'Sin soporte' : 'Deprecated'}</span>
	<span>{es ? 'APX v1 ya no se mantiene.' : 'APX v1 is no longer maintained.'}</span>
	<a href={v2}>{es ? 'Conocé APX v2' : 'Meet APX v2'}</a>
	<span class="sep" aria-hidden="true">·</span>
	<a href={upgrade}>{es ? 'Actualizar desde v1' : 'Upgrade from v1'} →</a>
</div>
<Default />

<style>
	.apx-v2-banner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.25rem 0.75rem;
		padding: 0.5rem var(--sl-nav-pad-x, 1rem);
		background: var(--sl-color-orange-low);
		color: var(--sl-color-orange-high);
		font-size: var(--sl-text-sm);
		line-height: 1.4;
		text-align: center;
	}
	.apx-v2-banner a {
		color: var(--sl-color-orange-high);
		font-weight: 600;
		text-decoration: none;
	}
	.apx-v2-banner a:hover {
		text-decoration: underline;
	}
	.tag {
		padding: 0.1rem 0.45rem;
		border-radius: 999px;
		background: var(--sl-color-orange);
		color: var(--sl-color-black);
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}
	.sep {
		opacity: 0.6;
	}
</style>
