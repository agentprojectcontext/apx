#!/usr/bin/env bash
# APX pre-push gate.
#
# Commits go through freely — but a push (which is the closest thing to
# "deploy" we have) must NOT succeed unless:
#   0. The branch policy allows it (scripts/push-policy.js, rule 19).
#   1. The backend test suite passes.
#   2. The web bundle builds cleanly (vite build + web typecheck).
#   3. For a push that reaches main: the e2e gate passes (scripts/e2e-gate.js).
#
# Anything that produces a dist/ or any other build output needs to be
# validated here, because the daemon ships those files via prepack/install
# and a broken build means broken installs downstream.
#
# Bypass (only when you know what you're doing): git push --no-verify.
# Skip just the web build for a doc-only push: APX_SKIP_WEB_BUILD=1 git push.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Colors — only when stderr is a TTY (so CI logs stay plain).
if [ -t 2 ]; then
  C_DIM=$'\033[2m'; C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_BOLD=$'\033[1m'; C_RST=$'\033[0m'
else
  C_DIM=""; C_RED=""; C_GREEN=""; C_BOLD=""; C_RST=""
fi

step() { printf "%spre-push:%s %s\n" "$C_BOLD" "$C_RST" "$1" >&2; }
fail() { printf "%spre-push FAILED:%s %s\n" "$C_RED" "$C_RST" "$1" >&2; exit 1; }
ok()   { printf "%s✓%s %s\n" "$C_GREEN" "$C_RST" "$1" >&2; }
skip() { printf "%s· skip%s %s\n" "$C_DIM" "$C_RST" "$1" >&2; }

START="$(date +%s)"

# git exports GIT_DIR / GIT_INDEX_FILE / … to its hooks, and every child
# process inherits them: a test that runs `git init` in a temp dir then acts on
# THIS repository instead (2026-09-29: core.bare flipped to true and the
# owner's user.name/email overwritten, from a test run inside this hook). The
# hook already cd'd to the repo root, so the cwd is all git needs from here on.
while IFS= read -r var; do unset "$var"; done < <(env | sed -n 's/^\(GIT_[A-Z_]*\)=.*/\1/p')

# -1) Branch policy (AGENTS.md rule 19). git hands the pushed refs on stdin;
#     scripts/push-policy.js refuses commits that exist only on main (work goes
#     through `staging` or a feature branch — hotfixes excepted, via a
#     `hotfix/<slug>` branch or APX_HOTFIX=1) and says whether this push reaches
#     main, in which case the e2e gate runs after the checks below.
step "branch policy (scripts/push-policy.js)"
if ! POLICY="$(node scripts/push-policy.js)"; then
  fail "push refused by the branch policy (see above)"
fi
POLICY="$(printf "%s\n" "$POLICY" | tail -1)"
ok "branch policy (${POLICY})"

# -0) Private terms (AGENTS.md rule 3). Reads the owner's LOCAL denylist
#     (spec/private-terms.txt or ~/.apx/private-terms.txt) and refuses the push
#     if a tracked file carries one of its terms. No list here → passes silently.
step "private terms (scripts/check-private-terms.js)"
if ! node scripts/check-private-terms.js >&2; then
  fail "a tracked file contains a term from the local private denylist (see above)"
fi
ok "private terms"

# 0) Lint — the layering rule (core -> adapter -> surface) is enforced here,
#    not by good intentions. Cheap, so it runs first and fails fast.
step "linting (npm run lint)"
if ! npm run lint --silent >/tmp/apx-pre-push-lint.log 2>&1; then
  printf "%s\n" "── eslint ──" >&2
  tail -40 /tmp/apx-pre-push-lint.log >&2
  fail "lint failed (full log: /tmp/apx-pre-push-lint.log)"
fi
ok "lint"

# 0b) The web panel's own lint. It is a separate pnpm workspace, so the root
#     eslint run above does not see a single one of its ~47k lines. Errors are
#     absolute; warnings ratchet against a baseline (scripts/lint-web.js).
step "linting web panel (npm run lint:web)"
if ! npm run lint:web --silent >/tmp/apx-pre-push-lint-web.log 2>&1; then
  printf "%s\n" "── eslint (web) ──" >&2
  tail -40 /tmp/apx-pre-push-lint-web.log >&2
  fail "web lint failed (full log: /tmp/apx-pre-push-lint-web.log)"
fi
ok "web lint"

# 1) Backend tests — the source of truth for behavior the daemon ships.
#    test:ci also refuses skipped/todo tests; a skipped test is one nobody
#    is watching.
step "running backend tests (npm run test:ci)"
if ! npm run test:ci --silent >/tmp/apx-pre-push-test.log 2>&1; then
  printf "%s\n" "── last 30 lines of npm test ──" >&2
  tail -30 /tmp/apx-pre-push-test.log >&2
  fail "backend tests failed (full log: /tmp/apx-pre-push-test.log)"
fi
ok "backend tests"

# 2) Web build — the daemon serves this on install, so a broken build means
#    a broken deploy. Skippable with APX_SKIP_WEB_BUILD=1 for doc/typo pushes.
if [ "${APX_SKIP_WEB_BUILD:-}" = "1" ]; then
  skip "web build (APX_SKIP_WEB_BUILD=1)"
else
  step "building web bundle (scripts/build-web.js)"
  if ! node scripts/build-web.js >/tmp/apx-pre-push-build.log 2>&1; then
    printf "%s\n" "── last 40 lines of build-web ──" >&2
    tail -40 /tmp/apx-pre-push-build.log >&2
    fail "web build failed (full log: /tmp/apx-pre-push-build.log)"
  fi
  ok "web build"

  # Strict TS check too — the build silences type errors with esbuild, so we
  # run tsc separately. One pre-existing error in calendar.tsx was fixed, so
  # the gate is "zero errors". If a new vendor file lands with errors that
  # aren't ours, downgrade this to a warning rather than blocking the push.
  step "web typecheck (tsc --noEmit)"
  if ! (cd src/interfaces/web && npx --no-install tsc --noEmit) >/tmp/apx-pre-push-tsc.log 2>&1; then
    printf "%s\n" "── tsc output ──" >&2
    cat /tmp/apx-pre-push-tsc.log >&2
    fail "web typecheck failed (full log: /tmp/apx-pre-push-tsc.log)"
  fi
  ok "web typecheck"
fi

# 3) The e2e gate — only for pushes that reach main, merges and hotfixes alike.
#    A daemon of its own on a fresh APX_HOME, the production bundle, real user
#    journeys (scripts/e2e-gate.js). It reuses the bundle built above — and
#    when that build was skipped (APX_SKIP_WEB_BUILD=1) it builds its own,
#    because an e2e run against a stale dist would test yesterday's panel.
if [ "$POLICY" = "gate" ]; then
  step "e2e gate (scripts/e2e-gate.js) — this push reaches main"
  if [ "${APX_SKIP_WEB_BUILD:-}" = "1" ]; then
    GATE=(env -u APX_SKIP_WEB_BUILD node scripts/e2e-gate.js)
  else
    GATE=(env APX_E2E_SKIP_BUILD=1 node scripts/e2e-gate.js)
  fi
  if ! "${GATE[@]}" >/tmp/apx-pre-push-e2e.log 2>&1; then
    printf "%s\n" "── last 60 lines of the e2e gate ──" >&2
    tail -60 /tmp/apx-pre-push-e2e.log >&2
    fail "e2e gate failed — main only takes green (full log: /tmp/apx-pre-push-e2e.log)"
  fi
  ok "e2e gate"
fi

END="$(date +%s)"
printf "%spre-push OK in %ss%s\n" "$C_GREEN" "$((END - START))" "$C_RST" >&2
