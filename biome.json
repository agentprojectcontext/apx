{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/out",
      "!packages/ui/playground",
      "!plan",
      "!**/*.html",
      "!packages/surfaces/src/kit/apx-kit.js",
      "!packages/ui/.design-sync",
      "!apps/mobile/package-lock.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "rules": {
      "recommended": true,
      "suspicious": {
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error", "warn"]
          }
        }
      },
      "style": {
        "noNonNullAssertion": "error",
        "useImportType": "error"
      },
      "correctness": {
        "noUnusedImports": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/terminal/**", "scripts/**", "**/scripts/**", "e2e/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/core/src/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/transport/**", "**/rpc/**", "**/channels/**"],
                    "message": "domain never imports transport, rpc or channels (AGENTS.md rule 4)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/core/src/rpc/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/transport/**"],
                    "message": "rpc never imports transport (AGENTS.md rule 4: transport \u2192 rpc \u2192 domain)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/apps/**", "@apx/core", "@apx/web", "@apx/desktop", "@apx/terminal"],
                    "message": "packages never import apps (AGENTS.md rule 4)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "style": {
            "useConst": "off",
            "useImportType": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
