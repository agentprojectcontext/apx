# Copy to .env and fill in. .env is gitignored — never commit the key.

# Which VPN provider gluetun should dial. See the gluetun docs for the full
# list; the WireGuard key below has to come from that same provider.
VPN_SERVICE_PROVIDER=protonvpn

# WireGuard private key.
# Proton: Account → Downloads → WireGuard configuration. Generate a config for
# the server you want and copy the PrivateKey line out of the .conf file.
WIREGUARD_PRIVATE_KEY=

# Exit countries to pick from. Comma-separated, no spaces after the commas.
SERVER_COUNTRIES=Netherlands

# Optional proxy auth. Safe to leave empty: the port is bound to loopback.
HTTPPROXY_USER=
HTTPPROXY_PASSWORD=

TZ=America/Argentina/Salta
