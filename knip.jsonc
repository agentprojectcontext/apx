// `pnpm check:dead`: files, exports, types and dependencies nothing reaches (knip). The entries below are the ways in
// that knip cannot see from package.json alone. The ignore lists are the allowlist: each says why, and
// treatConfigHintsAsErrors fails on one no longer needed, so they only shrink. apps/mobile and apps/docs install
// outside the workspace; their imports of packages/* were checked by hand when an export there was removed.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "treatConfigHintsAsErrors": true,
  // System tools the code runs; none is an npm package.
  "ignoreBinaries": ["codex", "cwebp", "ffmpeg", "iconutil", "mkfifo", "plutil", "scutil", "sips", "ssh-keygen", "xcode-select"],
  "ignoreIssues": {
    // Generated from the migrations (check:schema): every table's type is exported on purpose.
    "apps/core/src/db/schema.ts": ["types"],
    // Generated by packages/ui/scripts/export-blobs.mjs.
    "packages/ui/src/blobs/catalog.ts": ["types"]
  },
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.{ts,mjs}",
        "scripts/{browser,install}/**/*.{ts,js}",
        // Playwright configs run with --config; the hook and core are spawned by e2e/env.ts by path.
        "e2e/*.config.ts",
        "e2e/{baileys-hook,start-core}.ts",
        "prototypes/**/*.{ts,mjs,cjs}"
      ],
      "project": ["scripts/**/*.{ts,mjs,js}", "e2e/**/*.ts", "prototypes/**/*.{ts,mjs,cjs}"],
      // The desktop specs and the accessibility prototype drive apps/desktop's Electron.
      "ignoreDependencies": ["electron"]
    },
    "apps/core": {
      // Besides the bin (src/main.ts): runners and test fakes are spawned as processes by file path, never imported.
      "entry": ["src/**/*-runner.mjs", "src/**/*.test-support.mjs"],
      "project": ["src/**/*.{ts,mjs}"],
      // A template the agent copies into an owner's extension, not code the core runs.
      "ignore": ["src/skills/**/server-template.mjs"]
    },
    "apps/desktop": {
      // esbuild entries (scripts/build.ts) and the native helper's smoke script.
      "entry": ["src/main/main.ts", "src/panel/preload.ts", "scripts/*.ts", "native/**/*.mjs"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "apps/terminal": {
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      // index.html is the entry (vite plugin); late modules are reached through src/lazy.ts's dynamic imports.
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/ui": {
      // Build scripts, the playground and the Claude Design previews (.design-sync) import the package by path.
      "entry": ["scripts/*.mjs", "playground/*.{tsx,mjs}", ".design-sync/previews/*.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/surfaces": {
      // The widget kit is served to sandboxed widgets as a static file.
      "entry": ["src/kit/apx-kit.js"],
      "project": ["src/**/*.{ts,js}"]
    }
  }
}
